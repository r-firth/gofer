# Local development works without a token, on loopback only.
HUB_BIND=127.0.0.1
HUB_PORT=4318
# Codex strands run this model.
HUB_MODEL=gpt-6-astra
# The thread (a Claude coordinator) and Claude strands run this model at medium effort.
# Requires Claude Code 2.1.280 or later on every execution device.
HUB_CLAUDE_MODEL=claude-opus-5-5
# The name Gofer calls you by in its instructions and in memory. Optional.
# HUB_OWNER=Alex
# Semantic memory uses Gemini Embedding 2 via OpenRouter (indexing and queries).
# Indexed text is sent to OpenRouter; leave the key unset for text-only search.
# Changing the model or dimensions backs up old vectors and reindexes memory.
# OPENROUTER_API_KEY=replace-with-your-openrouter-key
HUB_EMBEDDING_MODEL=google/gemini-embedding-2
HUB_EMBEDDING_DIMENSIONS=768
# For home-server access, set a random token (at least 32 characters) and the
# exact browser origin. HTTPS enables PWA installation and WebGPU beyond localhost.
# HUB_TOKEN=replace-with-a-random-token
# HUB_PUBLIC_ORIGIN=https://your-server.your-tailnet.ts.net
# Additional exact hostname:port pairs accepted by the server (no wildcards).
# HUB_ALLOWED_HOSTS=your-server:4318,your-server.your-tailnet.ts.net:4318,100.64.0.1:4318
# HUB_DATA_DIR=/path/to/persistent/gofer-data
# HUB_ROOT=/path/to/gofer

# Automatic Tailscale SSH discovery runs on startup and every 30 seconds.
# HUB_DISCOVERY=off
# HUB_TAILSCALE_BIN=/path/to/tailscale
